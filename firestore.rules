rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'elherreroanapse@gmail.com' || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      ); 
    }
    
    match /{document=**} {
      allow read, write: if false;
    }

    match /agents/{agentId} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /telegramConnections/{connectionId} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /modelConfigs/{modelId} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /communicationRoutes/{routeId} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /logs/{logId} {
      allow read, create, delete: if isSignedIn();
    }

    match /appSettings/{settingId} {
      allow read, write: if isSignedIn();
    }

    match /admins/{adminId} {
      allow read: if false;
      allow write: if false;
    }
  }
}
