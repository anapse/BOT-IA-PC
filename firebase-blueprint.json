{
  "entities": {
    "Agent": {
      "title": "Agent",
      "description": "AI Agent configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "personality": { "type": "string" },
        "systemPrompt": { "type": "string" },
        "model": { "type": "string" },
        "telegramBotId": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "createdAt"]
    },
    "TelegramConnection": {
      "title": "TelegramConnection",
      "description": "Telegram bot connection configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "agentId": { "type": "string" },
        "botToken": { "type": "string" },
        "webhookUrl": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "createdAt"]
    },
    "ModelConfig": {
      "title": "ModelConfig",
      "description": "AI model provider configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "provider": { "type": "string" },
        "modelId": { "type": "string" },
        "connectionType": { "type": "string" },
        "endpoint": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "createdAt"]
    },
    "CommunicationRoute": {
      "title": "CommunicationRoute",
      "description": "Inter-agent communication routing rule",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sourceAgent": { "type": "string" },
        "targetAgent": { "type": "string" },
        "channel": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "sourceAgent", "targetAgent", "createdAt"]
    },
    "LogEntry": {
      "title": "LogEntry",
      "description": "System or technical log entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "level": { "type": "string" },
        "source": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "level", "message", "createdAt"]
    },
    "AppSetting": {
      "title": "AppSetting",
      "description": "Global application setting or configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "key": { "type": "string" },
        "value": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id"]
    }
  },
  "firestore": {
    "/agents/{agentId}": {
      "schema": "Agent",
      "description": "Collection of AI agents"
    },
    "/telegramConnections/{connectionId}": {
      "schema": "TelegramConnection",
      "description": "Collection of Telegram connections"
    },
    "/modelConfigs/{modelId}": {
      "schema": "ModelConfig",
      "description": "Collection of AI model configurations"
    },
    "/communicationRoutes/{routeId}": {
      "schema": "CommunicationRoute",
      "description": "Collection of agent communication routes"
    },
    "/logs/{logId}": {
      "schema": "LogEntry",
      "description": "Collection of technical logs"
    },
    "/appSettings/{settingId}": {
      "schema": "AppSetting",
      "description": "Collection of application settings"
    }
  }
}
