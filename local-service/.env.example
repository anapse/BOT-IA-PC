# Copy to .env locally. Never commit real values.
BOT_PC_HOST=127.0.0.1
BOT_PC_PORT=4317
# Generate a long random token. Keep it secret and separate from provider API keys.
BOT_PC_TOKEN=replace-with-at-least-32-random-characters
# Absolute Windows paths separated by ; . Only these roots can be accessed.
BOT_PC_ALLOWED_ROOTS=C:\BOT-IA-PC\Proyectos
# Data/memory/task state remains on this PC.
BOT_PC_DATA_DIR=./data
