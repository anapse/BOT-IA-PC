rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Admins (replace with actual logic, here just a placeholder check for the user email if needed, 
    // but instructed to use database lookup for RBAC)
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    match /{document=**} {
      allow read, write: if false;
    }

    match /agents/{agentId} {
      allow read: if isSignedIn(); // Simplified for now, should be role-based
      allow create: if isSignedIn() && isValidId(agentId);
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /telegramConnections/{connectionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(connectionId);
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /modelConfigs/{modelId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(modelId);
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }
  }
}
